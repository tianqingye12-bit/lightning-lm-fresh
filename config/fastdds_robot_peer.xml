<?xml version="1.0" encoding="UTF-8" ?>
<!-- 车端跨机 + 本机：保留内置传输（含本机 SHM），再加 WiFi peer 给 PC -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <participant profile_name="robot_to_pc" is_default_profile="true">
      <rtps>
        <!-- 不要关掉 builtin：否则本机未带同 profile 的 rslidar/astra 会被隔离开 -->
        <useBuiltinTransports>true</useBuiltinTransports>
        <builtin>
          <initialPeersList>
            <locator>
              <udpv4>
                <address>192.168.50.3</address>
              </udpv4>
            </locator>
            <locator>
              <udpv4>
                <address>192.168.50.95</address>
              </udpv4>
            </locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
